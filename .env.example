REMNA_RWMS_ADDR=127.0.0.1
REMNA_RWMS_PORT=50051

REMNA_POSTGRES_HOST=127.0.0.1
REMNA_POSTGRES_PORT=5432
REMNA_POSTGRES_USER=postgres
REMNA_POSTGRES_PASSWORD=postgres
REMNA_POSTGRES_DB=shredder

TRAFFIC_MONITOR_INTERVAL_SECONDS=600
TRAFFIC_MONITOR_ANOMALY_THRESHOLD_BYTES=53687091200
TRAFFIC_MONITOR_AUTO_BLOCK_ENABLED=false
TRAFFIC_MONITOR_AUTO_BLOCK_THRESHOLD_BYTES=107374182400
TRAFFIC_MONITOR_CREATE_SCHEMA=false
TRAFFIC_MONITOR_LOG_LEVEL=info

# Uses shredder-vpn-bot token by default when MI_VPN_BOT_TOKEN is present.
# Set this only if the monitor has a separate env from the VPN bot.
TRAFFIC_MONITOR_TELEGRAM_BOT_TOKEN=
TRAFFIC_MONITOR_TELEGRAM_NOTIFY_CHAT_ID=
# Or comma-separated:
TRAFFIC_MONITOR_TELEGRAM_NOTIFY_CHAT_IDS=
